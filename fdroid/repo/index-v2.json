        "sourceCode": "https://github.com/recloudstream/cloudstream",
        "authorName": "recloudstream",
        "name": {
          "en-US": "CloudStream"
        },
        "summary": {
          "en-US": "Open-source Android application for streaming and downloading media."
        },
        "description": {
          "en-US": "Cloudstream is an open-source Android application designed for streaming and downloading Movies, TV Shows, and Anime. Rather than hosting media, it relies on a modular extension system with custom providers.\n\nKey features:\n\n- Completely ad-free experience\n- No analytics, telemetry, or user tracking\n- Offline downloads for local media playback\n- Full Chromecast support\n- Integrated bookmarks, history, and episode tracking\n- Modular extension system for external providers\n- Optimized interface for both phones and Android TV\n"
        },
